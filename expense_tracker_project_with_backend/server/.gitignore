# ==========================================
# Personal Database (NEVER upload to GitHub)
# ==========================================
db/data.json
db/data.backup.json
db/*.backup.json
db/*.backup.*
db/*.sqlite
db/*.db

# Allow database template & metadata
!db/data.example.json
!db/.gitkeep
!db/README.md

